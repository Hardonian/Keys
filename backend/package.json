{
  "name": "hardonia-ai-companion-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "load-test": "tsx scripts/load-test.ts",
    "migrate": "tsx ../scripts/run-all-migrations.ts",
    "verify-migrations": "tsx ../scripts/verify-migrations.ts",
    "jobforge:admin": "tsx scripts/jobforge-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^7.80.0",
    "@supabase/supabase-js": "^2.103.0",
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.15.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.0",
    "form-data": "^4.0.5",
    "globals": "^14.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.1.1",
    "openai": "^4.20.0",
    "stripe": "^14.21.0",
    "typescript-eslint": "^8.58.0",
    "ws": "^8.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "4.1.4",
    "chai": "^5.1.2",
    "eslint": "^9.15.0",
    "msw": "^2.13.2",
    "pg": "^8.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
