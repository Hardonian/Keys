{
  "name": "hardonia-ai-companion-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_IGNORE_INCORRECT_LOCKFILE=1 next dev",
    "clean": "rm -rf .next node_modules && npm install",
    "build": "cross-env NODE_ENV=production NEXT_PRIVATE_LOCAL_SKIP_FONTS=1 NEXT_IGNORE_INCORRECT_LOCKFILE=1 next build",
    "start": "next start",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix && prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "node -e \"const fs=require('fs'); fs.mkdirSync('.next/types',{recursive:true}); if(!fs.existsSync('.next/types/__placeholder__.ts')) fs.writeFileSync('.next/types/__placeholder__.ts','export {}\\n');\" && tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test --project=visual-*",
    "test:visual:mobile": "playwright test --project=visual-mobile",
    "test:visual:tablet": "playwright test --project=visual-tablet",
    "test:visual:desktop": "playwright test --project=visual-desktop",
    "test:visual:dark": "playwright test --project=visual-*-dark",
    "test:visual:update": "playwright test --project=visual-* --update-snapshots",
    "test:audit": "playwright test --project=audit",
    "analyze": "ANALYZE=true next build",
    "validate": "npm run lint && npm run type-check && npm run test",
    "verify:fonts": "node scripts/verify-fonts.js",
    "verify": "npm run lint && npm run type-check && npm run build && npm run verify:fonts",
    "validate-assets": "node scripts/assets/validate.js"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/nextjs": "^10.36.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.97.0",
    "@xstate/react": "^5.0.0",
    "axios": "^1.13.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.25",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "marked": "^12.0.2",
    "next": "^16.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.71.2",
    "tailwind-merge": "^2.6.1",
    "xstate": "^5.28.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.33",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "autoprefixer": "^10.4.24",
    "cross-env": "^10.1.0",
    "eslint": "^9.26.0",
    "eslint-config-next": "^16.1.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.17",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
