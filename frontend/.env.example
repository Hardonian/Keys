# Keys Frontend Environment Variables
# Copy this to .env.local and configure as needed

# =============================================================================
# MODE: Standalone (No Backend Required)
# =============================================================================
# Leave Supabase variables empty to run in standalone mode.
# The frontend will use mock data and local functionality.

# =============================================================================
# MODE: With Supabase Backend (Optional)
# =============================================================================
# To enable Supabase integration, set these variables:

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# Other Configuration
# =============================================================================

# Analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Feature flags (optional)
# NEXT_PUBLIC_ENABLE_MARKETPLACE=true
