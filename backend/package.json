{
  "name": "hardonia-ai-companion-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "load-test": "tsx scripts/load-test.ts",
    "migrate": "tsx ../scripts/run-all-migrations.ts",
    "verify-migrations": "tsx ../scripts/verify-migrations.ts",
    "jobforge:admin": "tsx scripts/jobforge-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^7.120.4",
    "@supabase/supabase-js": "^2.110.0",
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "form-data": "^4.0.6",
    "globals": "^14.0.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.3.0",
    "openai": "^4.104.0",
    "stripe": "^14.25.0",
    "typescript-eslint": "^8.58.1",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "4.1.4",
    "chai": "^5.3.3",
    "eslint": "^9.39.2",
    "msw": "^2.14.6",
    "pg": "^8.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
